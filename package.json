{
  "name": "over-the-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:game": "vite --config vite.game.config.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json && vite build",
    "build:game": "tsc --noEmit -p tsconfig.game.json && vite build --config vite.game.config.ts",
    "preview": "vite preview",
    "studio": "npm run build && vite preview",
    "preview:game": "vite preview --config vite.game.config.ts",
    "pack:course": "node --experimental-strip-types scripts/pack-course.ts",
    "generate:showcase": "node --experimental-strip-types scripts/showcase/generate.ts",
    "generate:characters": "node --experimental-strip-types scripts/scenes/characters/generate.ts",
    "generate:default-course": "node --experimental-strip-types scripts/default-course/generate.ts",
    "generate:ashen-ascent": "node --experimental-strip-types scripts/ashen-ascent/generate.ts",
    "generate:streaming": "node --experimental-strip-types scripts/level-streaming/generate.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "0.185.4",
    "playwright": "1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "planck": "1.4.2",
    "three": "0.185.1"
  },
  "description": "A browser-based physics climbing playground inspired by Getting Over It, built with Three.js and Planck.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poshih/over-the-edge.git"
  }
}
